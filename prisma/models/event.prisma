model Event {
    id String @id @default(uuid())
    year Int
    type EventType
    name String
    about String?
    isDeleted Boolean @default(false)
    deletedTime String @default("")
    deletedBy String?
    deletedReason String?
    status EventStatus @default(ACTIVE)
    team Team[]
    committees Committee[]
    members Member[]
    attendance Attendance[]
    startDate DateTime
    endDate DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([year, type, deletedTime])
}

enum EventStatus {
    ACTIVE
    INACTIVE
}

enum EventType {
    INTRA
    MAIN
}

model Team {
    id String @id @default(uuid())
    name String
    about String?
    eventId String
    event Event @relation(fields: [eventId], references: [id])
    userId String
    user User @relation(fields: [userId], references: [id])
    role Role @default(ORGANIZER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([eventId, userId])
}

enum Role {
    ORGANIZER
    DELEGATE_AFFAIRS
    FINANCE_MANAGER
    ADMIN
    SUPER_ADMIN
}

model Committee {
    id String @id @default(uuid())
    name String
    slug String
    agenda String
    about String?
    capacity Int @default(0)
    eventId String
    members Member[]
    attendance Attendance[]
    event Event @relation(fields: [eventId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([slug, eventId])
}

model Attendance {
    id String @id @default(uuid())
    isPresent Boolean @default(false)
    date DateTime @db.Date
    memberId String
    member Member @relation(fields: [memberId], references: [id] )
    committeeId String
    committee Committee @relation(fields: [committeeId], references: [id])
    eventId String
    event Event @relation(fields: [eventId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([memberId, committeeId, date])
}